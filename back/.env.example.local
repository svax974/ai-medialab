# =============================================================================
# ai-medialab — internal Python engine (engine/, see back/src/modules/engine/README.md)
# =============================================================================
# Models, downloads, jobs and media encoding run in a separate FastAPI process on 127.0.0.1. Nest is its only client.
# Shared secret sent as X-Engine-Token (both processes read it). Generate: openssl rand -hex 32.
# ENGINE_TOKEN=
# Engine port (default 8000) and base URL (default http://127.0.0.1:<ENGINE_PORT>).
# ENGINE_PORT=8000
# ENGINE_URL=http://127.0.0.1:8000
# Timeout of a typed engine call in ms (default 30000); event-stream reconnection delays and idle limit in ms.
# ENGINE_TIMEOUT_MS=30000
# ENGINE_RECONNECT_MIN_MS=1000
# ENGINE_RECONNECT_MAX_MS=15000
# ENGINE_IDLE_TIMEOUT_MS=45000
# Set to false to not subscribe to the engine event stream at startup (default true).
# ENGINE_EVENTS_RELAY=true
# Data folder shared with the engine (which reads it as IMAGEGEN_DATA_DIR; scripts-local/dev-services.sh sets that).
# The Nest database is then <APP_DATA_DIR>/<DB_PATH>: use a name distinct from the legacy ai-medialab.db.
# APP_DATA_DIR=/absolute/path/to/ai-medialab/data
# DB_PATH=app.db
# Schema of the Nest database (src/migrations, see src/migrations/README.md). Dev: leave DB_SCHEMA_MODE unset or `sync` (TypeORM
# builds the tables). Desktop / production: DB_SCHEMA_MODE=migrations (the pending migrations run at startup). Never mix both on
# the same app.db file.
# DB_SCHEMA_MODE=migrations
# One-shot import of the legacy engine database (<APP_DATA_DIR>/ai-medialab.db) at startup; false disables it.
# LEGACY_IMPORT=true
