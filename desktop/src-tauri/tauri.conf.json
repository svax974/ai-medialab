{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI MediaLab",
  "version": "0.1.0",
  "identifier": "app.aimedialab.studio",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "public.app-category.graphics-design",
    "shortDescription": "Studio local de création et d'édition d'images",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../build/resources/engine": "engine",
      "../build/resources/frontend": "frontend",
      "../build/resources/runtime": "runtime",
      "../build/resources/engines": "engines"
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-",
      "hardenedRuntime": false
    }
  }
}
