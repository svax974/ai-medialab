    "/engine/v1/jobs": {
      "get": {
        "description": "Jobs that are queued or running.",
        "operationId": "list_jobs_engine_v1_jobs_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobList"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Jobs",
        "tags": [
          "jobs"
        ]
      },
      "post": {
        "description": "Queues a generation. Validation of the content (empty prompt, missing reference...) is reported by `job.failed`.",
        "operationId": "submit_job_engine_v1_jobs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JobSubmit"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
